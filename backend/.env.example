# RMS Backend Configuration

# Database
DATABASE_URL=sqlite:///./rms.db

# LLM Configuration
LLM_API_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Embedding Configuration
